        { "path": "<PRODUCTS>/AgottWatch.app", "id": "A22BFCA3556DC9B268582093", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Agott/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
