  "targets": [
    {
      "name": "Agott",
      "id": "276F3F39309CBCF400258BA6",
      "product": "Products/Agott.app",
      "product-type": "application",
      "dependencies": [
        { "target": "AgottWatch", "platforms": [ "ios" ] },
        { "target": "AgottSafari", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "FluidAudio",
          "product-name": "FluidAudio",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "macos" ] },
        },
      ],
      "build-settings": {
        "AGOTT_ICON_Debug": "Agott Dev",
        "AGOTT_ICON_Release": "Agott Icon",
