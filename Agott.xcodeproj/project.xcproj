    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Agott.app", "id": "276F3F3A309CBCF400258BA6", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AgottTests.xctest", "id": "276F3F49309CBCF500258BA6", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AgottUITests.xctest", "id": "276F3F53309CBCF500258BA6", "type": "wrapper.cfbundle", "index": false },
