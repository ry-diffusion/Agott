        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Agott.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "7B3G244WZG",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE[sdk=iphoneos*]": "Agott-iOS-Info.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "Agott-iOS-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Agott",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Agott drafts emails in Mail and controls your apps when you ask it to.",
        "INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription": "Agott reads and adds events when you ask it to.",
        "INFOPLIST_KEY_NSContactsUsageDescription": "Agott matches phone numbers in your chats to the names of the people you know.",
        "INFOPLIST_KEY_NSHealthShareUsageDescription": "Agott reads your workouts and heart rate to show how your sets improve over time.",
        "INFOPLIST_KEY_NSHealthUpdateUsageDescription": "Agott saves the workouts it counts to Health, with every set and its reps.",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Agott connects your iPhone to Agott on your Mac over your local network.",
        "INFOPLIST_KEY_NSLocationUsageDescription": "Agott uses your city so it knows where you are when you ask about places, routes, the time or the weather.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Agott uses your city so it knows where you are when you ask about places, routes, the time or the weather.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Agott listens while you hold the talk key, so you can speak to it.",
        "INFOPLIST_KEY_NSMotionUsageDescription": "Agott counts your reps from your AirPods' motion.",
        "INFOPLIST_KEY_NSRemindersFullAccessUsageDescription": "Agott reads and adds tasks when you ask it to.",
        "INFOPLIST_KEY_NSSpeechRecognitionUsageDescription": "Agott turns what you say into text on this device.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "27.2",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "br.com.zesmoi.Agott",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
