    "zen.sample.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm a bit down today"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tô meio pra baixo hoje"
          }
        }
      }
    },
    "zen.sample.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I figured. You were quiet in the group and didn't answer Ana. Want to talk about what weighed on you?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "imaginei. você ficou quieto no grupo e não respondeu a Ana. quer falar do que pesou?"
          }
        }
      }
    },
    "zen.sample.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I think it's college, I feel behind on everything"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acho que é a faculdade, sinto que tô atrasado em tudo"
          }
        }
      }
    },
    "zen.sample.4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That makes sense, it was a heavy week: three deliveries and Friday's call.\n\nBut look: you finished two. One is left, and it fits tomorrow morning, calmly."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "faz sentido, a semana foi puxada: três entregas e a call de sexta.\n\nmas olha: você terminou duas. falta uma, e dá pra fazer amanhã de manhã, com calma."
          }
        }
      }
    },
    "zen.sample.5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yeah… thanks"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "é… valeu"
          }
        }
      }
    },
    "zen.sample.6" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm here. Want me to remind you at 9 tomorrow, or would you rather just rest now?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tô aqui. quer que eu te lembre amanhã às 9, ou prefere só descansar agora?"
          }
        }
      }
    },
