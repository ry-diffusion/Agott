<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The iPhone finds the Mac running Agott over Bonjour. iOS will not let
	     an app browse for a service type it has not declared here, and Xcode
	     has no INFOPLIST_KEY_ setting for this array. Generated keys are
	     merged on top of this file. -->
	<!-- iOS wakes Agott now and then to sync routines, so a day done on
	     the Watch or the Mac stops the phone's reminders. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>br.com.zesmoi.Agott.routines</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_agott._tcp</string>
	</array>
</dict>
</plist>
